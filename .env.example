# Copy this file to ".env" and fill in your values. The launcher loads it automatically.

# Language-model backend: ollama (local, default) or claude (Anthropic API)
LODESTAR_PROVIDER=ollama
LODESTAR_MODEL=granite4.1:8b
LODESTAR_VISION_MODEL=granite3.2-vision
# ANTHROPIC_API_KEY=sk-ant-...        # only needed for LODESTAR_PROVIDER=claude

# Optional: Langfuse tracing
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: customer names / account codes the Jira import must always mask
# LODESTAR_CUSTOMER_NAMES=Acme Bank,Acme,ACME_PROD
